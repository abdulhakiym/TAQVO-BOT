
# ==========================================
# TAQVO PRO MAX - ENVIRONMENT CONFIGURATION
# ==========================================

# APPLICATION
APP_NAME=TAQVO PRO MAX
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# TELEGRAM BOT
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_USERNAME=YOUR_BOT_USERNAME
CHANNEL_USERNAME=@hakiymqalb

# TELEGRAM MINI APP
WEBAPP_URL=https://your-domain.com
APP_BASE_URL=https://your-domain.com

# DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/taqvo_pro_max

# SECURITY
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
WEBAPP_INITDATA_MAX_AGE=86400

# TIMEZONE
DEFAULT_TIMEZONE=Asia/Tashkent

# PRAYER TIMES
PRAYER_API_BASE_URL=https://api.aladhan.com/v1
PRAYER_CALCULATION_METHOD=3
PRAYER_ASR_METHOD=0

# REMINDERS
PRAYER_REMINDERS_ENABLED=true
PRAYER_REMINDER_MINUTES=5
AKHIRAH_REMINDERS_ENABLED=true
MORNING_REMINDER_TIME=08:00
EVENING_REMINDER_TIME=20:00

# SCHEDULER
SCHEDULER_ENABLED=true

# LOGGING
LOG_LEVEL=INFO

# AI CONFIGURATION
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=

# KNOWLEDGE BASE
KNOWLEDGE_SEARCH_ENABLED=true
VECTOR_SEARCH_ENABLED=false

# ADMIN
ADMIN_TELEGRAM_IDS=

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
